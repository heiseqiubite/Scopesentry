<svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- 外圈护盾 -->
  <path d="M24 4L36 8V20C36 28.8 30.6 37.2 24 40C17.4 37.2 12 28.8 12 20V8L24 4Z" 
        fill="#1565C0" fill-opacity="0.1" stroke="#1565C0" stroke-width="2"/>
  
  <!-- 内圈瞄准镜 -->
  <circle cx="24" cy="22" r="10" fill="none" stroke="#1565C0" stroke-width="2"/>
  <circle cx="24" cy="22" r="6" fill="none" stroke="#00C853" stroke-width="1.5"/>
  <circle cx="24" cy="22" r="2" fill="#00C853"/>
  
  <!-- 扫描线 -->
  <path d="M14 22L18 22M30 22L34 22M24 12L24 16M24 28L24 32" 
        stroke="#FF6D00" stroke-width="2" stroke-linecap="round">
    <animate attributeName="stroke-opacity" values="0.3;1;0.3" dur="2s" repeatCount="indefinite"/>
  </path>
  
  <!-- 数据点 -->
  <circle cx="20" cy="18" r="1" fill="#00C853" opacity="0.8"/>
  <circle cx="28" cy="18" r="1" fill="#00C853" opacity="0.8"/>
  <circle cx="20" cy="26" r="1" fill="#00C853" opacity="0.8"/>
  <circle cx="28" cy="26" r="1" fill="#00C853" opacity="0.8"/>
</svg>